---
// <picture>: AVIF + WebP + JPEG yedek. Astro'nun <Picture> bileşeni tek bir kalite değerini bütün
// biçimlere uyguluyor; AVIF aynı sayıda WebP'den büyük çıktığı için kaliteyi biçim başına ayırıyoruz.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  /** JPEG yedeğinin genişliği */
  fallbackWidth?: number;
  avifQuality?: number;
  webpQuality?: number;
  eager?: boolean;
}

const { src, alt, widths, sizes, fallbackWidth = widths[Math.floor(widths.length / 2)], avifQuality = 44, webpQuality = 58, eager = false } = Astro.props;

const ws = widths.filter((w) => w <= src.width);
const set = async (format: 'avif' | 'webp', quality: number) =>
  (await Promise.all(ws.map(async (width) => `${(await getImage({ src, width, format, quality })).src} ${width}w`))).join(', ');

const [avif, webp, fallback] = await Promise.all([
  set('avif', avifQuality),
  set('webp', webpQuality),
  getImage({ src, width: fallbackWidth, format: 'jpg', quality: 70 }),
]);
---

<picture>
  <source type="image/avif" srcset={avif} sizes={sizes} />
  <source type="image/webp" srcset={webp} sizes={sizes} />
  <img
    src={fallback.src}
    width={src.width}
    height={src.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
</picture>
