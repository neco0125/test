---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Reel from '../components/Reel.astro';
import WeddingDay from '../components/WeddingDay.astro';
import WeddingGallery from '../components/WeddingGallery.astro';
import Ground from '../components/Ground.astro';
import { SITE, pad2, wa } from '../config';
import { DRONE_DELIVER, OTHER_SERVICES, WEDDING_DAY, WEDDING_RECEIVE } from '../data/content';
import { weddingGallery } from '../data/weddingGallery';
import { GROUPS } from '../data/services';
import heroWide from '../assets/img/hero-gece.jpg';
import heroSquare from '../assets/img/hero-gece-kare.jpg';
import yacht from '../assets/img/yat-scope.jpg';
import portrait from '../assets/img/necip-portre.jpg';

// Hero afişi (LCP): döngünün ilk karesi. Dikey ekranlarda kare kırpım, yatayda 16:9.
const srcset = async (src: typeof heroWide, widths: number[], format: 'avif' | 'webp', quality: number) =>
  (await Promise.all(widths.map(async (w) => `${(await getImage({ src, width: w, format, quality })).src} ${w}w`))).join(', ');
const [sqAvif, sqWebp, wdAvif, wdWebp, fallback] = await Promise.all([
  srcset(heroSquare, [480, 720], 'avif', 46),
  srcset(heroSquare, [480, 720], 'webp', 60),
  srcset(heroWide, [960, 1280], 'avif', 46),
  srcset(heroWide, [960, 1280], 'webp', 60),
  getImage({ src: heroWide, width: 1280, format: 'jpg', quality: 70 }),
]);
const portraitMedia = '(max-aspect-ratio: 1/1), (max-width: 760px)';

const title = 'Alanya fotoğrafçı, drone ve düğün videosu | Necip Bozdemir';
const description =
  'Alanya fotoğrafçı Necip Bozdemir: Alanya ve Antalya’da düğün, aile ve ürün fotoğrafı, 4K drone çekimi, 2-3 saatlik düğün filmi ve 1-3 dakikalık klip.';

// Ana sayfadaki "Alanya’da fotoğraf" bölümü: iç bağlantılar
const PHOTO_LINKS = [
  { name: 'Düğün fotoğrafı', text: 'Hazırlıktan ilk dansa tam gün. Düğün filmi ve klip de aynı ekipten.', href: '/dugun/' },
  { name: 'Drone fotoğrafı ve videosu', text: 'Otel, yat, mekân ve etkinlik. 4K, 50 ya da 60 fps.', href: '/drone/' },
  { name: 'Portre, aile ve ürün', text: 'Dış çekim, aile, çift, kurumsal portre ve ürün fotoğrafı.', href: '/hizmetler/' },
  { name: 'Galeri', text: 'Düğün ve drone çekimlerinden kareler.', href: '/galeri/' },
  { name: 'Dış çekim mekânları', text: 'Kale, Kızıl Kule, Tophane, sahil: hangi saatte, hangi ışıkta.', href: '/blog/alanya-dis-cekim-mekanlari/' },
  { name: 'Fotoğrafçı seçerken', text: 'Tam albüm, sözleşme ve görüşmede sorulacak sorular.', href: '/blog/dugun-fotografcisi-secimi/' },
];

const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#isletme`,
  name: SITE.name,
  description,
  url: `${SITE.url}/`,
  image: `${SITE.url}/og.jpg`,
  logo: `${SITE.url}/apple-touch-icon.png`,
  telephone: SITE.phoneE164,
  address: { '@type': 'PostalAddress', addressLocality: SITE.locality, addressRegion: SITE.region, addressCountry: 'TR' },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.lat, longitude: SITE.lon },
  areaServed: [
    { '@type': 'City', name: 'Alanya' },
    { '@type': 'City', name: 'Antalya' },
  ],
  knowsAbout: ['Fotoğrafçılık', 'Drone çekimi', 'Düğün filmi', 'Düğün fotoğrafçılığı', 'Portre ve aile fotoğrafı', 'Ürün fotoğrafı', 'Tanıtım filmi', 'Instagram Reels', 'Mekân tanıtım videosu', 'Etkinlik çekimi'],
  founder: { '@id': `${SITE.url}/hakkimizda/#necip` },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Hizmetler',
    url: `${SITE.url}/hizmetler/`,
    itemListElement: GROUPS.map((g) => ({
      '@type': 'OfferCatalog',
      name: g.title,
      itemListElement: g.items.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, description: s.text } })),
    })),
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '18:00' },
  ],
  sameAs: [SITE.instagram, SITE.gbp],
  hasMap: SITE.gbp,
  contactPoint: { '@type': 'ContactPoint', telephone: SITE.phoneE164, contactType: 'customer service', availableLanguage: 'Turkish' },
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE.url}/#site`, name: SITE.name, url: `${SITE.url}/`, inLanguage: 'tr', publisher: { '@id': `${SITE.url}/#isletme` } };
const firstWedding = weddingGallery[0];
---

<Base title={title} description={description} schema={[business, website]} fullTitle overlay altimeter serifAbove>
  <link slot="preload" rel="preload" as="image" imagesrcset={sqAvif} imagesizes="100vh" type="image/avif" media={portraitMedia} fetchpriority="high" />

  <section class="hero" aria-labelledby="hero-h">
    <div class="hero__media" data-hero data-l="/media/hero-1280.mp4" data-s="/media/hero-720.mp4">
      <picture>
        <source media={portraitMedia} type="image/avif" srcset={sqAvif} sizes="100vh" />
        <source media={portraitMedia} type="image/webp" srcset={sqWebp} sizes="100vh" />
        <source type="image/avif" srcset={wdAvif} sizes="100vw" />
        <source type="image/webp" srcset={wdWebp} sizes="100vw" />
        <img
          src={fallback.src}
          width="1280"
          height="720"
          alt="Gece, ışıklar içindeki Alanya’da kalabalık bir etkinlik alanının tam üstten drone görüntüsü"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>
    <div class="vf" aria-hidden="true">
      <span class="tl rec">REC <span data-tc>00:00:00:00</span></span>
      <span class="tr">ALT 120 m</span>
      <span class="center"></span>
      <span class="bl">{SITE.coords}</span>
      <span class="br">Alanya · Antalya</span>
    </div>
    <div class="hero__body wrap">
      <p class="hero__kicker mono">Alanya · Fotoğraf, drone ve düğün filmi</p>
      <h1 class="hero__title" id="hero-h">
        <span class="sr">Alanya fotoğrafçısı: drone çekimi, düğün fotoğrafı ve videosu. </span>
        <span class="ln"><span class="wide">Yukarıdan</span></span>
        <span class="ln"><span class="serif">yakından.</span></span>
      </h1>
      <div class="hero__foot">
        <p class="hero__lead">
          Alanya’nın fotoğrafçısıyız. Alanya ve Antalya’da fotoğraf, video ve drone çekiyoruz: otelin, yatın, mekânın bütününü havadan, düğünü çiftin
          bir adım yanından.
        </p>
        <div class="cta-row">
          <a class="btn" href={wa('Merhaba, tarih sormak istiyorum.')} rel="noopener">Tarihinizi sorun <span class="arrow" aria-hidden="true">→</span></a>
          <a class="link" href="#havadan">Çalışmaları izleyin <span class="arrow--down" style="display:inline-block" aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="lenses" aria-label="İki lens: drone ve düğün">
    <a class="lens lens--drone t-night" href="/drone/">
      <div class="lens__media">
        {/* kart dikey, geniş fotoğraf yüksekliğe göre kaplanır: gösterilen genişlik ≈ kart yüksekliği × 2,39 */}
        <Pic src={yacht} alt="" widths={[960, 1280, 1920, 2752]} sizes="(min-width: 56rem) max(50vw, clamp(81rem, 220vh, 139rem)), max(100vw, clamp(81rem, 220vh, 139rem))" avifQuality={48} webpQuality={68} />
      </div>
      <div class="lens__top mono"><span>01 · Yukarıdan</span><span>ALT 120 m</span></div>
      <h2 class="wide xl" style="font-size:clamp(3.25rem,1rem + 7.6vw,9rem)">Drone</h2>
      <p class="lens__sub serif">otel, yat, mekân, etkinlik</p>
      <span class="lens__go">Drone çekimi <span class="arrow" aria-hidden="true">→</span></span>
    </a>
    <a class="lens lens--wed t-ivory" href="/dugun/">
      {
        firstWedding && (
          <div class="lens__media">
            <Pic src={firstWedding.src} alt="" widths={[640, 960, 1280]} sizes="(min-width: 56rem) 50vw, 100vw" />
          </div>
        )
      }
      <div class="lens__top mono"><span>02 · Yakından</span><span>ALT 1,7 m</span></div>
      <div>
        <h2 class="serif lens__word">düğün.</h2>
        <p class="lens__sub serif" style="margin-top:.6rem">hazırlıktan ilk dansa</p>
        <ol class="lens__day mono">
          {WEDDING_DAY.map((s) => <li>{s.name}</li>)}
        </ol>
        <span class="lens__go">Düğün filmi ve fotoğraf <span class="arrow" aria-hidden="true">→</span></span>
      </div>
    </a>
  </section>

  <section class="chap t-teal" id="havadan" aria-labelledby="havadan-h">
    <div class="wrap">
      <div class="chap__hd">
        <p class="alt-tag mono"><b>ALT 90 m</b> Yukarıdan</p>
        <h2 class="wide xl" id="havadan-h">Havadan</h2>
        <p class="lead">Otel, yat, mekân ve etkinlik tanıtımı. Bina blokları, havuz, deniz ve kale aynı karede.</p>
      </div>
      <Reel />
      <div class="split" style="margin-top:clamp(3.5rem,8vw,6.5rem)">
        <div>
          <h3 class="wide m">Ne teslim ediyoruz</h3>
          <a class="btn" style="margin-top:2rem" href="/drone/">Drone çekimi <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <dl class="kv">
          {
            DRONE_DELIVER.map((f) => (
              <div>
                <dt class="mono">{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="chap t-ivory" id="dugun" aria-labelledby="dugun-h">
    <div class="wrap">
      <div class="chap__hd">
        <p class="alt-tag mono"><b>ALT 1,7 m</b> Yakından</p>
        <h2 id="dugun-h" style="display:grid">
          <span class="serif l" style="font-size:clamp(3rem,1rem + 7.4vw,9.5rem)">Bir adım ötede</span>
          <span class="wide l" style="padding-left:clamp(1rem,8vw,9rem)">bütün gün.</span>
        </h2>
        <p class="lead">Düğün gününü sabah hazırlıktan gece son dansa kadar, sırasıyla çekiyoruz. Poz verdirmeden, olanı bekleyerek.</p>
      </div>

      <p class="mono" style="margin-bottom:2.5rem">Düğün gününüz, adım adım</p>
      <WeddingDay />

      <WeddingGallery limit={7} />

      <div class="split" style="margin-top:clamp(4rem,9vw,7.5rem)">
        <div>
          <h3 class="wide m">Ne alırsınız</h3>
          <p class="copy" style="margin-top:1.25rem">Hazır paket yok. Teklifi düğününüzün süresine ve yerine göre hazırlıyoruz.</p>
          <a class="btn" style="margin-top:2rem" href="/dugun/">Düğün sayfası <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ol class="rows">
          {
            WEDDING_RECEIVE.map((r, i) => (
              <li class="row row--3">
                <span class="row__no mono">{pad2(i + 1)}</span>
                <h4 class="row__name">{r.name}</h4>
                <p>{r.text}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="split" style="margin-top:clamp(4rem,9vw,7.5rem);padding-top:clamp(3rem,6vw,5rem);border-top:1px solid var(--rule)" role="region" aria-labelledby="diger-h">
        <div>
          <p class="alt-tag mono"><b>ALT 1,7 m</b> Diğer işler</p>
          <h2 class="serif" id="diger-h" style="font-size:var(--t-serif-l);margin-top:1.25rem">ve gerisi.</h2>
          <p class="copy" style="margin-top:1.25rem">Bütün hizmetler ve WhatsApp’tan hazır mesajlar <a href="/hizmetler/">hizmetler sayfasında</a>. Düğün ve drone üzerine notlar <a href="/blog/">blogda</a>.</p>
        </div>
        <ul class="rows">
          {
            OTHER_SERVICES.map((s, i) => (
              <li>
                <a class="row row--4" href={s.href}>
                  <span class="row__no mono">{pad2(i + 1)}</span>
                  <span class="row__name">{s.name}</span>
                  <p>{s.text}</p>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="chap t-teal" id="fotograf" aria-labelledby="fotograf-h">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="alt-tag mono"><b>ALT 1,7 m</b> Fotoğraf</p>
          <h2 class="serif" id="fotograf-h" style="font-size:var(--t-serif-l);margin-top:1.25rem">Alanya’da fotoğraf.</h2>
          <div class="copy" style="margin-top:1.25rem">
            <p>
              Alanya’da fotoğrafçı arıyorsanız neleri çektiğimiz kısaca şöyle: düğün, nişan, kına ve Save the Date; aile, çift ve portre; otel, restoran
              ve ürün; havadan drone fotoğrafı ve videosu. Alanya’nın yanında Antalya’daki çekimlere de gidiyoruz.
            </p>
            <p>
              Fotoğrafı ve videoyu aynı ekip çekiyor: Necip Bozdemir ve 2020’den beri fotoğraf ve videoyla uğraşan Yusuf Balkan. Videoları 4K çekip
              yatay 16:9 ve dikey 9:16 teslim ediyoruz. Save the Date çekimini düğünden 1-2 ay önce planlıyoruz, çekim 2-3 saat sürüyor. Her işin
              kapsamı yazılı sözleşmede.
            </p>
          </div>
        </div>
        <ul class="rows">
          {
            PHOTO_LINKS.map((s, i) => (
              <li>
                <a class="row row--4" href={s.href}>
                  <span class="row__no mono">{pad2(i + 1)}</span>
                  <span class="row__name">{s.name}</span>
                  <p>{s.text}</p>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="chap t-night" aria-labelledby="ben-h" style="padding-bottom:0">
    <div class="wrap about">
      <figure class="about__img">
        <Pic
          src={portrait}
          widths={[400, 640, 960]}
          sizes="(min-width: 56rem) 38vw, 92vw"
          alt="Necip Bozdemir sahnede, elindeki kamera düzeneğinin ekranına bakıyor"
        />
      </figure>
      <div class="about__txt">
        <p class="alt-tag mono"><b>ALT 0,5 m</b> Kameranın arkası</p>
        <h2 class="serif" id="ben-h" style="margin-top:1.5rem">Ben Necip.</h2>
        <p class="lead" style="margin-top:1.5rem;max-width:30ch">
          Alanya’da çekim yapıyorum. Lokasyonları, ışık saatlerini ve mekânları iyi tanırım.
        </p>
        <p class="copy" style="margin-top:1.25rem">
          Fotoğrafı, filmi ve drone görüntüsünü aynı ekip çekiyor. Kurgu, renk ve ses de bizde. Teklif, sözleşme ve teslim tarihi yazılı.
        </p>
        <div class="about__stats mono">
          <span><b>Alanya</b>Antalya</span>
          <span><b>50/60</b>fps drone</span>
        </div>
        <a class="link" style="display:inline-block;margin-top:2rem" href="/hakkimizda/">Nasıl çalışıyoruz <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Ground />
</Base>
