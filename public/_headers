# Cloudflare Pages başlıkları. nginx karşılığı DEPLOY.md içinde.
# Pages eşleşen bütün kuralları birleştirir. Genel kural en üstte; özel kurallar
# "! Cache-Control" ile genel değeri kaldırıp kendi değerini koyar.

/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/media/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/og.jpg
  ! Cache-Control
  Cache-Control: public, max-age=604800

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/*.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600

/llms.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600

/wv.js
  ! Cache-Control
  Cache-Control: public, max-age=604800

/rum.js
  ! Cache-Control
  Cache-Control: public, max-age=604800

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=604800

/favicon-192.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/favicon-48.png
  ! Cache-Control
  Cache-Control: public, max-age=604800
